# NVR credentials — backend only (never sent to the browser). Copy to .env and fill in.
# Each NVR has its OWN variables; the backend refuses to start if two NVRs share one.

# CP Plus NVR (192.168.80.136)
CPPLUS_NVR_HOST=
CPPLUS_NVR_PORT=554
CPPLUS_NVR_USERNAME=
CPPLUS_NVR_PASSWORD=

# Hikvision NVR (192.168.80.114)
HIKVISION_NVR_HOST=
HIKVISION_NVR_PORT=554
HIKVISION_NVR_USERNAME=
HIKVISION_NVR_PASSWORD=
